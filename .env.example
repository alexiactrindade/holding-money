# Porta do servidor
PORT=3000

# Segredo dos tokens de login (se vazio, é gerado e salvo em data/.jwt_secret)
JWT_SECRET=

# Use true quando o app estiver atrás de HTTPS
COOKIE_SECURE=false

# Pasta do banco SQLite (padrão: ./data)
DATA_DIR=

# Inteligência artificial: definida aqui por quem instala. O usuário final só liga ou desliga no app.
# Sem chave, o app esconde os recursos de IA e funciona no modo básico.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# gemini | anthropic | openai (opcional; detectado pela chave preenchida)
AI_PROVIDER=
# Modelo (opcional). Padrões: gemini-3.5-flash / claude-sonnet-5-5 / gpt-4o-mini
AI_MODEL=
